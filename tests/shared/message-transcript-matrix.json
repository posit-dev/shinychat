      {"type":"stream_chunk","stream_id":"other","content":"bad","content_type":"markdown","operation":"append"}
    ],
    "error": "Cannot write to a stream that is not active"
  },
  {
    "name": "active_identity_accepts_nested_writes",
    "operations": [
      {"type":"stream_start","stream_id":"primary","role":"assistant","segments":[]},
      {"type":"stream_chunk","stream_id":"primary","content":"outer","content_type":"markdown","operation":"append"},
      {"type":"stream_chunk","stream_id":"primary","content":" nested","content_type":"markdown","operation":"append"},
      {"type":"stream_end","stream_id":"primary"}
