[
  {
    "name": "complete_wire_specs_preserve_display_metadata",
    "operations": [
      {
        "operation": "complete-message",
        "wire_spec": {
          "message": {
            "role": "user",
            "segments": [
              {"content": "Hi", "content_type": "markdown"}
            ],
            "attachments": [
              {
                "mime": "text/plain",
                "data_url": "data:text/plain;base64,SGk=",
                "name": "hi.txt",
                "size": 2
              }
            ]
          }
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "complete-message",
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {
                "content": "Hello",
                "content_type": "text",
                "html_deps": [
                  {"name": "chart", "metadata": {"version": "1.0"}}
                ]
              }
            ]
          },
          "icon": "<i>assistant</i>"
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "defensive-read",
        "entry": 0,
        "replacement": "mutated"
      }
    ],
    "expected": [
      {
        "message": {
          "role": "user",
          "segments": [
            {"content": "Hi", "content_type": "markdown"}
          ],
          "attachments": [
            {
              "mime": "text/plain",
              "data_url": "data:text/plain;base64,SGk=",
              "name": "hi.txt",
              "size": 2
            }
          ]
        }
      },
      {
        "message": {
          "role": "assistant",
          "segments": [
            {
              "content": "Hello",
              "content_type": "text",
              "html_deps": [
                {"name": "chart", "metadata": {"version": "1.0"}}
              ]
            }
          ]
        },
        "icon": "<i>assistant</i>"
      }
    ],
    "expected_transport": ["complete-message", "complete-message"]
  },
  {
    "name": "failed_complete_send_does_not_commit",
    "operations": [
      {
        "operation": "complete-message",
        "wire_spec": {
          "message": {
            "role": "user",
            "segments": [
              {"content": "kept", "content_type": "markdown"}
            ]
          }
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "complete-message",
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {"content": "discarded", "content_type": "markdown"}
            ]
          },
          "icon": ""
        },
        "send": {"result": "error", "message": "send failed"}
      }
    ],
    "error": "send failed",
    "expected": [
      {
        "message": {
          "role": "user",
          "segments": [
            {"content": "kept", "content_type": "markdown"}
          ]
        }
      }
    ],
    "expected_transport": ["complete-message", "complete-message"]
  },
  {
    "name": "stream_replace_preserves_mixed_segments_and_opening_exchange",
    "operations": [
      {
        "operation": "accepted-input",
        "exchange": "older",
        "wire_spec": {
          "message": {
            "role": "user",
            "segments": [
              {"content": "older request", "content_type": "markdown"}
            ]
          }
        }
      },
      {
        "operation": "stream-start",
        "stream_id": "older-stream",
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {"content": "", "content_type": "markdown"}
            ]
          }
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "stream-chunk",
        "stream_id": "older-stream",
        "source_segments": [
          {"content": "reasoning", "content_type": "thinking"}
        ],
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {"content": "reasoning", "content_type": "thinking"}
            ]
          }
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "accepted-input",
        "exchange": "newer",
        "wire_spec": {
          "message": {
            "role": "user",
            "segments": [
              {"content": "newer request", "content_type": "markdown"}
            ]
          }
        }
      },
      {
        "operation": "stream-chunk",
        "stream_id": "older-stream",
        "source_segments": [
          {"content": "reasoning", "content_type": "thinking"},
          {"content": "draft", "content_type": "markdown"}
        ],
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {"content": "draft", "content_type": "markdown"}
            ]
          }
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "stream-chunk",
        "stream_id": "older-stream",
        "transition": "replace",
        "source_segments": [
          {"content": "reasoning", "content_type": "thinking"},
          {"content": "answer", "content_type": "markdown"}
        ],
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {"content": "reasoninganswer", "content_type": "markdown"}
            ]
          }
        },
        "send": {"result": "sent"}
      },
      {
        "operation": "stream-end",
        "stream_id": "older-stream",
        "source_segments": [
          {"content": "reasoning", "content_type": "thinking"},
          {"content": "answer", "content_type": "markdown"}
        ],
        "wire_spec": {
          "message": {
            "role": "assistant",
            "segments": [
              {"content": "", "content_type": "markdown"}
            ]
          }
        },
        "send": {"result": "sent"}
      }
    ],
    "expected_exchanges": {"1": "older"},
    "expected": [
      {
        "message": {
          "role": "user",
          "segments": [
            {"content": "older request", "content_type": "markdown"}
          ]
        }
      },
      {
        "message": {
          "role": "assistant",
          "segments": [
            {"content": "reasoninganswer", "content_type": "markdown"}
          ]
        }
      },
      {
        "message": {
          "role": "user",
          "segments": [
            {"content": "newer request", "content_type": "markdown"}
          ]
        }
      }
    ],
    "expected_transport": [
      "stream-start",
      "stream-chunk",
      "stream-chunk",
      "stream-chunk",
      "stream-end"
    ]
  },
